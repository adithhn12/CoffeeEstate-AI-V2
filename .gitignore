# Environment Variables (Protect Secrets)
.env
.env.local
.env.*.local
!.env.example

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/

# Node.js / Frontend
node_modules/
frontend/dist/
frontend/node_modules/
frontend/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Database & Storage (Prevent committing local databases & transaction logs)
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm
coffee_estate.db

# Large Datasets & Archives (>100MB GitHub reject limit)
datasets/
*.zip
*.tar
*.tar.gz

# Ultralytics & Faster R-CNN Training Runs & Evaluation Artifacts
runs/
ml/runs/
ml/logs/

# Model Weights (>100MB GitHub reject limit)
*.pth
weights/
yolo26n.pt
yolo26s.pt

# Redundant Base YOLO Weights (Trained checkpoint is at ml/weights/best.pt)
yolov8s.pt
yolov8n.pt
backend/yolov8s.pt

# Explicitly Preserve Trained Custom Weights
!ml/weights/best.pt

# Runtime Uploads (Preserve directory structure via .gitkeep)
uploads/raw/*
!uploads/raw/.gitkeep
uploads/annotated/*
!uploads/annotated/.gitkeep
uploads/coorg_local/*
!uploads/coorg_local/.gitkeep

# Regression test outputs
post_redesign_regression_sample.json

# IDE & OS Metadata
.DS_Store
Thumbs.db
Desktop.ini
.idea/
.vscode/
*.swp
*.swo

# Task logs & temporary caches
*.log
